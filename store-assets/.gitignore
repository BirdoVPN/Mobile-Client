# (see generate_assets.py). Everything below is reproducible on demand:
#     python store-assets/generate_assets.py --render
preview-*.png
study-*.png
thumb-*.png
icon-play-512.png
ic_launcher_round-192.png

# The 432px adaptive-icon layers. Intermediates like the rest: generate_assets.py derives the
# shipped per-density mipmaps (app/src/main/res/mipmap-*/ic_launcher_{background,foreground,
# monochrome}.png) from them. Raster on purpose; see issue #150 and generate_assets.py.
adaptive-*.png
