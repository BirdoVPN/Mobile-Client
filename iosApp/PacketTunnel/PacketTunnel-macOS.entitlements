<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      macOS packet-tunnel extension entitlements for Mac App Store.

      The extension is sandboxed too — on macOS an appex inherits the host's
      sandbox requirement, and NEProvider extensions are refused entirely if
      the sandbox entitlement is absent.
    -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!--
      The tunnel's own traffic. Deliberately network.client ONLY — no
      network.server. App Review's automated scan rejected build 10420 for
      carrying network.server without listener functionality (guideline 2.4.5),
      and it was never needed: WireGuard is outbound-initiated. The client
      sends the handshake first, and every inbound datagram — handshake
      response and all subsequent transport packets — arrives as a reply on
      that same established UDP flow, which network.client covers. Nothing in
      the app or the extension calls bind/listen/NWListener (verified), and the
      official WireGuard Mac App Store client ships its extension without
      network.server. Port forwarding does not need it either: forwarded
      traffic arrives THROUGH the tunnel via utun, not on a listening socket.
    -->
    <key>com.apple.security.network.client</key>
    <true/>

    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>

    <!--
      Same shared keychain group as the host app. The extension reads the
      WireGuard private key and preshared key from here; a mismatch fails with
      errSecMissingEntitlement (-34018) and the tunnel dies at startTunnel with
      missingConfig — the exact failure already documented on the iOS side.
    -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)app.birdo.vpn</string>
    </array>

</dict>
</plist>
