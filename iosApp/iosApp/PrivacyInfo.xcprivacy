<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Privacy manifest for the BirdoVPN app target. Required since 2024-05-01:
         App Store Connect rejects uploads (ITMS-91053) whose binary uses a
         required-reason API without a declared reason. The app uses UserDefaults
         across several files (SettingsViewModel, AuthViewModel, VpnViewModel,
         VPNManager, APIClient, SSOService). XcodeGen's `sources: [path: iosApp]`
         glob bundles this file into the .app automatically. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Email address: collected to create / sign in to the account. Linked
             to identity, not used for tracking. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Persistent device identifier: "ios_" + a RANDOM v4 UUID minted on
             this install (APIClient.mintDeviceId), persisted in the keychain
             so it survives reinstall (APIClient deviceContext()); sent on
             every auth/connect call as deviceId and rotated when the account
             is deleted. Installs that minted it before the switch keep their
             older IDFV-derived value until then. Linked to the account, not
             used for tracking. Matches the Play data-safety declaration for
             the Android identifier. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- User ID (MR-1689): the account's identifiers. Every signed-in call
             carries the account's tokens, which name its account id, and an
             anonymous account signs in with its 24-digit account number
             (POST /auth/login/anonymous). The server stores both (privacy
             policy section 3.1). Linked to the account, not used for tracking.
             This replaces an Other User Content entry that filed the account
             identifier there: the app sends no user-generated content (its
             request bodies are sign-in, device, connect, port-forward,
             purchase and deletion fields only). -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Purchase history (audit 2026-09-29, C-21 / D-19): every App Store
             purchase's signed transaction (product, purchase and expiry dates,
             original transaction id) is sent to our backend and bound to the
             Birdo account (StoreKitService.ingest -> POST
             /payments/store/apple/link; re-sent on sign-in and restore) so the
             server can grant the plan. Linked to the account, not tracking. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults — app-scoped defaults for app functionality. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
