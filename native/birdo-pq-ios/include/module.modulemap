// NOT a `framework module`: build-birdo-pq-xcframework.sh wraps a STATIC LIBRARY
// (libbirdo_pq_ios.a + Headers/), not a .framework bundle. Declaring it as a
// framework module makes Clang look for the umbrella header at a framework-
// relative path and fail with "umbrella header 'birdo_pq_ios.h' not found",
// which breaks `import BirdoPQNative` in BirdoPQManager.swift.
module BirdoPQNative {
    umbrella header "birdo_pq_ios.h"

    export *
    module * { export * }
}
