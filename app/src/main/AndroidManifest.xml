<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- VPN -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wifi info for auto-connect -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- FIX-1-10: Replace QUERY_ALL_PACKAGES with targeted <queries> to comply
         with Google Play policy. Only queries launcher apps for split tunneling UI. -->

    <!-- Query launcher apps for split tunneling app picker -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BirdoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BirdoVPN"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">

        <!--
            Disable Sentry auto-init ContentProviders.
            Sentry SDK v7 registers SentryInitProvider and SentryPerformanceProvider
            which run BEFORE Application.onCreate(). They read DSN from meta-data and
            crash if it's a placeholder/invalid value. We init Sentry manually in BirdoApp.
        -->
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BirdoVPN"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep links: birdo:// custom scheme -->
            <!-- FIX-2-11: Removed autoVerify — only valid for https:// App Links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="birdo" />
            </intent-filter>

            <!-- Deep links: https://birdo.app verified links -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="birdo.app" />
                <data android:pathPrefix="/connect" />
                <data android:pathPrefix="/dashboard" />
            </intent-filter>
        </activity>

        <!-- VPN Service -->
        <service
            android:name=".service.BirdoVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Google Play required justification: VPN tunnel that encrypts ALL user traffic.
                 Cannot be deferred or scheduled - must run continuously while connected. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel that encrypts and routes all user network traffic to a remote VPN server. Must run continuously while user is connected; cannot be deferred or restarted without breaking the encrypted tunnel and exposing user IP/DNS." />
            <!--
                Always-on VPN is SUPPORTED. The platform starts the service with
                the android.net.VpnService action at boot, on unlock and when the
                setting changes; BirdoVpnService.onStartCommand treats that (and a
                sticky restart, and an app update) as a system start: it arms the
                kill-switch block first when the kill switch or "Block connections
                without VPN" asks for one, then asks VpnManager for a HEADLESS
                connect from the persisted session (last server or Multi-Hop pair,
                Keystore-sealed tokens, a fresh WireGuard key per connect). Signed
                out, consent missing or a refusal never fails open silently: the
                block holds and an "Action needed" alert says what to do. Pinned by
                ApiLevel36ContractTest: this may only read "true" while that
                handler exists.
            -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
        </service>

        <!-- Restores the session after an app update (the update kills the process,
             tunnel and block included). Not exported: only the system delivers
             MY_PACKAGE_REPLACED, and only to this package. -->
        <receiver
            android:name=".service.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tile — Toggle VPN from notification shade -->
        <service
            android:name=".service.BirdoTileService"
            android:exported="true"
            android:icon="@drawable/ic_vpn_tile"
            android:label="BirdoVPN"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Home Screen Widget -->
        <receiver
            android:name=".widget.BirdoWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/birdo_widget_info" />
        </receiver>

    </application>

</manifest>
